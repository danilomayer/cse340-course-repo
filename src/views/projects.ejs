<%- include('partials/header') %>
    <main>
        <p class="eyebrow">Find your next opportunity</p>
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <li class="project-item">
                    <div class="project-type">
                        <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
                    </div>
                    <div>
                        <h3><%= project.project_title %></h3>
                        <p><%= project.location %> &middot; <em><%= project.organization_name %></em></p>
                    </div>
                </li>
            <% }) %>
        </ul>
    </main>
    <%- include('partials/footer') %>