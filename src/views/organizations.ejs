<%- include('partials/header') %>
    <main>
        <p class="eyebrow">Working together</p>
        <h1><%= title %></h1>
        <p class="intro">Meet the local organizations making these service opportunities possible.</p>
        <section class="cards" aria-label="Partner organizations">
            <% organizations.forEach(organization=> { %>
                <article class="card">
                    <img src="/images/<%= organization.logo %>" alt="<%= organization.name %> logo">
                    <h3><%= organization.name %></h3>
                    <p><%= organization.description %></p>
                    <p><a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
                </article>
                <% }); %>
        </section>
    </main>
    <%- include('partials/footer') %>